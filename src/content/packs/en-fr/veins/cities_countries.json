{
  "id": "cities_countries",
  "name": "Cities & countries",
  "pattern": "à + city · en + feminine country · au + masculine · aux + plural",
  "pattern_note": "Cities take «à». Countries need a gendered preposition: en (feminine or vowel), au (masculine), aux (plural).",
  "cefr": "A2",
  "unlock_cost": 200,
  "prereq": [
    "gender_traps"
  ],
