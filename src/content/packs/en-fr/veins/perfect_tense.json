{
  "id": "perfect_tense",
  "name": "Passé composé: être or avoir?",
  "pattern": "être + past participle (agrees) for motion/state verbs · avoir for the rest",
  "pattern_note": "Verbs of movement and state change (aller, venir, partir, arriver, rester, naître…) use être, and the participle agrees with the subject.",
  "cefr": "B1",
  "unlock_cost": 400,
  "prereq": [
    "irregular_present"
  ],
  "items": [
    {
      "id": "perfect_tense_suis_alle",
      "chunk": "je suis allé",
      "word": "je suis allé",
      "translation": "I went",
      "example": "Hier, je suis allé au marché.",
      "example_translation": "Yesterday, I went to the market.",
      "cloze": "Hier, ___ au marché.",
      "tiles": [
        "Hier",
        "je",
        "suis",
        "allé",
        "au",
        "marché"
      ],
      "distractor_tiles": [
        "ai",
        "allée"
      ],
      "notes": "Aller takes être. Never «j'ai allé».",
      "tags": [
        "B1"
      ],
      "wrong": [
        "j'ai allé",
        "je ai allé",
        "je suis aller"
      ],
      "strict": true
    },
    {
