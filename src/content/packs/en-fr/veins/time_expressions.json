{
  "id": "time_expressions",
  "name": "Time: depuis, il y a, pendant, dans",
  "pattern": "depuis + present (still true) · il y a = ago · dans = in (future)",
  "pattern_note": "English uses «for» for all of these. French picks one by meaning: still going (depuis), finished (pendant), ago (il y a), future (dans).",
  "cefr": "B1",
  "unlock_cost": 300,
  "prereq": [
    "irregular_present"
  ],
  "items": [
    {
      "id": "time_expressions_depuis_ans",
      "chunk": "depuis deux ans",
      "word": "depuis",
      "translation": "for two years (and still)",
      "example": "J'habite ici depuis deux ans.",
      "example_translation": "I have lived here for two years.",
      "cloze": "J'habite ici ___ deux ans.",
      "tiles": [
        "J'habite",
        "ici",
        "depuis",
        "deux",
        "ans"
      ],
      "distractor_tiles": [
        "pendant",
        "dans"
      ],
      "notes": "Still true now → depuis + PRESENT («j'habite», not «j'ai habité»).",
      "tags": [
        "B1"
      ],
      "wrong": [
        "pendant",
        "il y a",
        "dans"
      ],
      "strict": true,
      "allowSpot": false,
      "phonetic": "dəpɥi dø zɑ̃"
    },
    {
      "id": "time_expressions_il_y_a_ans",
      "chunk": "il y a deux ans",
      "word": "il y a",
      "translation": "two years ago",
      "example": "Je suis arrivé ici il y a deux ans.",
      "example_translation": "I arrived here two years ago.",
      "cloze": "Je suis arrivé ici ___ deux ans.",
      "tiles": [
        "Je",
        "suis",
        "arrivé",
        "ici",
        "il",
