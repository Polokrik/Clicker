        "a",
        "deux",
        "ans"
      ],
      "distractor_tiles": [
        "depuis",
        "dans"
      ],
      "notes": "Il y a + duration = ago, with a past tense.",
      "tags": [
        "B1"
      ],
      "wrong": [
        "depuis",
        "pendant",
        "dans"
      ],
      "strict": true,
      "allowSpot": false,
      "phonetic": "il ja dø zɑ̃"
    },
