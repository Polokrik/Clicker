{
  "id": "pronouns_y_en",
  "name": "Pronouns y & en",
  "pattern": "y = à/dans + thing/place · en = de + thing, or a quantity",
  "pattern_note": "«Y» replaces à + thing or a place. «En» replaces de + thing, or a quantity. They come before the verb.",
  "cefr": "B1",
  "unlock_cost": 450,
  "prereq": [
    "partitives"
  ],
  "items": [
    {
      "id": "pronouns_y_en_jy_vais",
      "chunk": "j'y vais",
      "word": "j'y vais",
      "translation": "I go there",
      "example": "Le marché ? Oui, j'y vais demain.",
      "example_translation": "The market? Yes, I'm going there tomorrow.",
      "cloze": "Le marché ? Oui, ___ demain.",
      "tiles": [
        "Le",
        "marché",
        "Oui",
        "j'y",
        "vais",
        "demain"
      ],
      "distractor_tiles": [
        "en"
      ],
      "notes": "«Y» replaces a place: aller à → y aller. Before a vowel: j'y.",
      "tags": [
        "B1"
      ],
      "wrong": [
        "j'en vais",
        "je y vais",
        "j'y va"
      ],
      "strict": true,
      "allowSpot": true,
      "phonetic": "ʒi vɛ"
    },
    {
      "id": "pronouns_y_en_jen_veux",
      "chunk": "j'en veux",
      "word": "j'en veux",
      "translation": "I want some",
      "example": "Du pain ? Oui, j'en veux deux.",
      "example_translation": "Some bread? Yes, I want two.",
      "cloze": "Du pain ? Oui, ___ deux.",
      "tiles": [
        "Du",
        "pain",
        "Oui",
        "j'en",
        "veux",
        "deux"
      ],
      "distractor_tiles": [
        "y",
        "veut"
      ],
      "notes": "«En» replaces du/de la/des + noun. Keep the number after the verb: j'en veux deux.",
      "tags": [
        "B1"
      ],
      "wrong": [
        "j'y veux",
        "je en veux",
        "j'en veut"
      ],
      "strict": true,
      "allowSpot": true,
      "phonetic": "ʒɑ̃ vø"
    },
