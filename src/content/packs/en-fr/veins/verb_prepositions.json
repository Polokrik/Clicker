{
  "id": "verb_prepositions",
  "name": "Verbs & their prepositions",
  "pattern": "penser à · rêver de · compter sur · jouer à (sport) / jouer de (instrument)",
  "pattern_note": "Each French verb has its own preposition, often different from English. Learn verb + preposition as one block.",
  "cefr": "B1",
  "unlock_cost": 350,
  "prereq": [
    "cities_countries"
  ],
  "items": [
    {
      "id": "verb_prepositions_penser_a",
      "chunk": "penser à",
      "word": "penser à",
      "translation": "to think about",
      "example": "Je vais penser à mes amis.",
      "example_translation": "I'm going to think about my friends.",
      "cloze": "Je vais ___ mes amis.",
      "tiles": [
        "Je",
        "vais",
        "penser",
        "à",
        "mes",
        "amis"
      ],
      "distractor_tiles": [
        "de",
        "sur"
      ],
      "notes": "«Penser à» = to think of/about someone. «Penser de» only asks for an opinion.",
      "tags": [
        "B1"
      ],
      "wrong": [
        "penser de",
        "penser sur",
        "penser pour"
      ],
      "strict": true,
      "allowSpot": true,
      "phonetic": "pɑ̃se a"
    },
    {
      "id": "verb_prepositions_rever_de",
      "chunk": "rêver de",
      "word": "rêver de",
      "translation": "to dream of",
      "example": "Elle aime rêver de voyages lointains.",
      "example_translation": "She likes dreaming of faraway trips.",
      "cloze": "Elle aime ___ voyages lointains.",
      "tiles": [
        "Elle",
        "aime",
        "rêver",
        "de",
        "voyages",
        "lointains"
      ],
      "distractor_tiles": [
        "à",
        "sur"
      ],
      "notes": "Rêver de + noun or infinitive.",
      "tags": [
        "B1"
      ],
      "wrong": [
        "rêver sur",
        "rêver pour",
        "rêver en"
      ],
      "strict": true,
      "allowSpot": true,
      "phonetic": "ʁɛve də"
    },
    {
      "id": "verb_prepositions_dependre_de",
      "chunk": "dépendre de",
      "word": "dépendre de",
      "translation": "to depend on",
      "example": "Le prix va dépendre de la saison.",
      "example_translation": "The price will depend on the season.",
      "cloze": "Le prix va ___ la saison.",
      "tiles": [
        "Le",
        "prix",
        "va",
        "dépendre",
        "de",
        "la",
        "saison"
      ],
      "distractor_tiles": [
        "à",
        "sur"
      ],
      "notes": "English «depend ON» → French «dépendre DE».",
      "tags": [
        "B1"
      ],
      "wrong": [
        "dépendre à",
        "dépendre sur",
        "dépendre en"
      ],
      "strict": true,
      "allowSpot": true,
      "phonetic": "depɑ̃dʁ də"
    },
    {
      "id": "verb_prepositions_sinteresser_a",
