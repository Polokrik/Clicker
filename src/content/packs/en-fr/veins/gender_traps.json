{
  "id": "gender_traps",
  "name": "Gender curveballs",
  "pattern": "Learn the article WITH the noun",
  "pattern_note": "The ending of a French noun is a hint, not a rule. Always memorise «un/une» together with the word.",
  "cefr": "A2",
  "unlock_cost": 0,
  "prereq": [],
  "items": [
    {
      "id": "gender_traps_problem",
      "chunk": "un problème",
      "word": "un problème",
      "translation": "a problem",
      "example": "Il y a un problème avec ma réservation.",
      "example_translation": "There is a problem with my booking.",
      "cloze": "Il y a ___ avec ma réservation.",
      "tiles": [
        "Il",
        "y",
        "a",
        "un",
        "problème",
        "avec",
        "ma",
        "réservation"
      ],
      "distractor_tiles": [
        "une",
        "le"
      ],
      "notes": "Masculine despite the final -e: all Greek-origin -ème nouns (problème, système, thème…).",
      "tags": [
        "A2"
      ],
      "wrong": [
        "une problème",
        "la problème",
        "des problème"
      ],
      "strict": true,
      "phonetic": "œ̃ pʁɔblɛm"
    },
    {
