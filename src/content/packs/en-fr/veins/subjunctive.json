      "tiles": [
        "Bien",
        "que",
        "ce",
        "soit",
        "cher",
        "je",
        "l'achète"
      ],
      "distractor_tiles": [
        "est",
        "sera"
      ],
      "notes": "Bien que + subjunctive: soit, not «est».",
      "tags": [
        "B1"
      ],
      "wrong": [
        "est",
        "sera",
        "sont"
      ],
      "strict": true,
      "phonetic": "bjɛ̃ kə sə swa"
    },
    {
