{
  "id": "subjunctive",
  "name": "Subjunctive triggers",
  "pattern": "il faut que / bien que / pour que / avant que + subjunctive",
  "pattern_note": "Certain expressions force the subjunctive. Learn the trigger, then the form — no need to «feel» it.",
  "cefr": "B1",
  "unlock_cost": 500,
  "prereq": [
    "perfect_tense"
  ],
  "items": [
    {
      "id": "subjunctive_faut_parte",
      "chunk": "il faut que je parte",
      "word": "parte",
      "translation": "I have to leave",
      "example": "Il faut que je parte avant dix heures.",
      "example_translation": "I have to leave before ten o'clock.",
      "cloze": "Il faut que je ___ avant dix heures.",
      "tiles": [
        "Il",
        "faut",
        "que",
        "je",
        "parte",
        "avant",
        "dix",
        "heures"
      ],
      "distractor_tiles": [
        "pars",
        "partir"
      ],
      "notes": "Il faut que + subjunctive (never the infinitive or indicative).",
      "tags": [
        "B1"
      ],
      "wrong": [
        "pars",
        "partir",
        "partirai"
      ],
      "strict": true,
      "phonetic": "il fo kə ʒə paʁt"
    },
    {
      "id": "subjunctive_bien_que_soit",
      "chunk": "bien que ce soit",
      "word": "soit",
      "translation": "although it is",
