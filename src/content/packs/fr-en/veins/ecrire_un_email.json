{
  "id": "ecrire_un_email",
  "name": "Écrire un email",
  "pattern": "I'm writing to + verbe",
  "pattern_note": "« I'm writing to confirm / to follow up / to ask » : l'ouverture standard d'un email pro qui annonce tout de suite l'objectif.",
  "cefr": "B1",
  "unlock_cost": 800,
  "prereq": ["en_reunion"],
  "items": [
    {
      "id": "email_confirm",
      "chunk": "I'm writing to confirm",
      "word": "to confirm",
      "translation": "confirmer",
      "example": "I'm writing to confirm our meeting.",
      "example_translation": "Je vous écris pour confirmer notre réunion.",
      "cloze": "I'm writing ___ our meeting.",
      "tiles": ["I'm", "writing", "to", "confirm", "our", "meeting"],
      "distractor_tiles": ["to cancel", "confirming"],
      "notes": "Le patron de la veine : « I'm writing to + verbe » annonce l'objet du mail.",
      "tags": ["verbe", "B1"]
    },
    {
      "id": "email_regarding",
      "chunk": "regarding",
      "word": "regarding",
      "translation": "concernant / au sujet de",
      "example": "I'm writing regarding your invoice.",
      "example_translation": "Je vous écris au sujet de votre facture.",
      "cloze": "I'm writing ___ your invoice.",
      "tiles": ["I'm", "writing", "regarding", "your", "invoice"],
      "distractor_tiles": ["according", "resulting"],
      "notes": "« regarding » = plus formel que « about ». « invoice » = facture.",
      "tags": ["préposition", "B1"]
    },
    {
      "id": "email_attached",
      "chunk": "please find attached",
      "word": "attached",
      "translation": "ci-joint",
      "example": "Please find attached the report.",
      "example_translation": "Veuillez trouver ci-joint le rapport.",
      "cloze": "Please find ___ the report.",
      "tiles": ["Please", "find", "attached", "the", "report"],
      "distractor_tiles": ["included", "joined"],
      "notes": "Piège : ne pas traduire « ci-joint » par « joined ». C'est « attached ».",
      "tags": ["expression", "B1"]
    },
    {
      "id": "email_looking_forward",
      "chunk": "looking forward to hearing from you",
      "word": "looking forward to",
      "translation": "dans l'attente de / avoir hâte de",
      "example": "I'm looking forward to hearing from you.",
      "example_translation": "Dans l'attente de votre réponse.",
      "cloze": "I'm ___ hearing from you.",
      "tiles": ["I'm", "looking", "forward", "to", "hearing", "from", "you"],
      "distractor_tiles": ["waiting for", "looking after"],
      "notes": "Après « looking forward to », le verbe prend -ing : hearing, meeting, seeing.",
      "tags": ["expression", "B1"]
    },
    {
      "id": "email_regards",
      "chunk": "Best regards",
      "word": "regards",
      "translation": "cordialement",
      "example": "Best regards, Paul.",
      "example_translation": "Cordialement, Paul.",
      "cloze": "Best ___, Paul.",
      "tiles": ["Best", "regards", "Paul"],
      "distractor_tiles": ["greetings", "salutations"],
      "notes": "« Best regards », « Kind regards » ou juste « Best » : l'équivalent de « cordialement ».",
      "tags": ["expression", "B1"]
    },
    {
      "id": "email_as_discussed",
      "chunk": "as discussed",
      "word": "as discussed",
      "translation": "comme convenu",
      "example": "As discussed, here is the planning.",
      "example_translation": "Comme convenu, voici le planning.",
      "cloze": "___, here is the planning.",
      "tiles": ["As", "discussed", "here", "is", "the", "planning"],
      "distractor_tiles": ["As talking", "How discussed"],
      "notes": "« as discussed » / « as agreed » : rappelle un accord précédent en deux mots.",
      "tags": ["expression", "B1"]
    },
    {
      "id": "email_let_me_know",
      "chunk": "let me know if",
      "word": "let me know",
      "translation": "dites-moi / tenez-moi au courant",
      "example": "Let me know if you have any questions.",
      "example_translation": "Dites-moi si vous avez des questions.",
      "cloze": "___ if you have any questions.",
      "tiles": ["Let", "me", "know", "if", "you", "have", "any", "questions"],
      "distractor_tiles": ["Make me know", "Tell me if know"],
      "notes": "« Let me know » : intraduisible mot à mot, à retenir en bloc.",
      "tags": ["expression", "B1"]
    },
    {
      "id": "email_in_advance",
      "chunk": "thank you in advance",
      "word": "in advance",
      "translation": "d'avance",
      "example": "Thank you in advance for your help.",
      "example_translation": "Merci d'avance pour votre aide.",
      "cloze": "Thank you ___ for your help.",
      "tiles": ["Thank", "you", "in", "advance", "for", "your", "help"],
      "distractor_tiles": ["in advanced", "by advance"],
      "notes": "« in advance », jamais « by advance » (calque du français).",
      "tags": ["expression", "B1"]
    },
    {
      "id": "email_asap",
      "chunk": "as soon as possible",
      "word": "as soon as possible",
      "translation": "dès que possible",
      "example": "Could you reply as soon as possible?",
      "example_translation": "Pourriez-vous répondre dès que possible ?",
      "cloze": "Could you reply ___?",
      "tiles": ["Could", "you", "reply", "as", "soon", "as", "possible"],
      "distractor_tiles": ["so soon as can", "as fast possible"],
      "notes": "Souvent abrégé « ASAP » à l'écrit. « reply » = répondre (à un message).",
      "tags": ["expression", "B1"]
    }
  ]
}
