{
  "id": "petites_conversations",
  "name": "Petites conversations",
  "pattern": "Questions ouvertes : Where / What / How long…",
  "pattern_note": "Le small talk vit de questions simples : Where are you from ? What do you do ? La préposition reste souvent en fin de question.",
  "cefr": "A2",
  "unlock_cost": 1000,
  "prereq": ["prendre_les_transports"],
  "items": [
    {
      "id": "talk_from",
      "chunk": "Where are you from?",
      "word": "from",
      "translation": "de (origine)",
      "example": "Where are you from exactly?",
      "example_translation": "D'où viens-tu exactement ?",
      "cloze": "Where are you ___ exactly?",
      "tiles": ["Where", "are", "you", "from", "exactly"],
      "distractor_tiles": ["of", "to"],
      "notes": "La préposition finit la question : Where are you FROM ?",
      "tags": ["question", "A2"]
    },
    {
      "id": "talk_im_from",
      "chunk": "I'm from France",
      "word": "I'm from",
      "translation": "je viens de",
      "example": "I'm from France, near Paris.",
      "example_translation": "Je viens de France, près de Paris.",
      "cloze": "___ France, near Paris.",
      "tiles": ["I'm", "from", "France", "near", "Paris"],
      "distractor_tiles": ["I come", "I live"],
      "notes": "« I'm from » + pays/ville : la façon la plus simple de dire d'où l'on vient.",
      "tags": ["expression", "A2"]
    },
    {
      "id": "talk_what_do",
      "chunk": "What do you do?",
      "word": "do",
      "translation": "faire",
      "example": "What do you do for a living?",
      "example_translation": "Que fais-tu dans la vie ?",
      "cloze": "What do you ___ for a living?",
      "tiles": ["What", "do", "you", "do", "for", "a", "living"],
      "distractor_tiles": ["work", "make"],
      "notes": "« What do you do? » = quel est ton métier ? « for a living » = pour gagner ta vie.",
      "tags": ["question", "A2"]
    },
    {
      "id": "talk_work_in",
      "chunk": "I work in",
      "word": "work in",
      "translation": "travailler dans",
      "example": "I work in consulting.",
      "example_translation": "Je travaille dans le conseil.",
      "cloze": "I ___ consulting.",
      "tiles": ["I", "work", "in", "consulting"],
      "distractor_tiles": ["work at", "work for"],
      "notes": "« in » + secteur, « for » + entreprise : I work in finance, I work for Google.",
      "tags": ["verbe", "A2"]
    },
    {
      "id": "talk_like",
      "chunk": "Do you like",
      "word": "do you like",
      "translation": "aimes-tu",
      "example": "Do you like living here?",
      "example_translation": "Tu aimes vivre ici ?",
      "cloze": "___ living here?",
      "tiles": ["Do", "you", "like", "living", "here"],
      "distractor_tiles": ["Are you like", "Do you love it"],
      "notes": "Après « like », le verbe prend -ing : I like living here.",
      "tags": ["question", "A2"]
    },
    {
      "id": "talk_staying",
      "chunk": "How long are you staying?",
      "word": "staying",
      "translation": "rester",
      "example": "How long are you staying in town?",
      "example_translation": "Combien de temps restes-tu en ville ?",
      "cloze": "How long are you ___ in town?",
      "tiles": ["How", "long", "are", "you", "staying", "in", "town"],
      "distractor_tiles": ["stay", "leaving"],
      "notes": "Le présent en -ing sert aussi pour les projets déjà décidés.",
      "tags": ["verbe", "A2"]
    },
    {
      "id": "talk_weather",
      "chunk": "Lovely weather",
      "word": "weather",
      "translation": "temps (météo)",
      "example": "Lovely weather today, isn't it?",
      "example_translation": "Beau temps aujourd'hui, n'est-ce pas ?",
      "cloze": "Lovely ___ today, isn't it?",
      "tiles": ["Lovely", "weather", "today", "isn't", "it"],
      "distractor_tiles": ["time", "whether"],
      "notes": "Piège : « weather » (météo) ≠ « whether » (si). Et le temps qui passe = « time ».",
      "tags": ["nom", "A2"]
    },
    {
      "id": "talk_nice_talking",
      "chunk": "Nice talking to you",
      "word": "talking",
      "translation": "parler / discuter",
      "example": "It was nice talking to you.",
      "example_translation": "C'était sympa de discuter avec toi.",
      "cloze": "It was nice ___ to you.",
      "tiles": ["It", "was", "nice", "talking", "to", "you"],
      "distractor_tiles": ["to talk", "saying"],
      "notes": "La formule de sortie polie d'une conversation. Avec -ing après « nice ».",
      "tags": ["expression", "A2"]
    },
    {
      "id": "talk_first_time",
      "chunk": "Is this your first time",
      "word": "first time",
      "translation": "première fois",
      "example": "Is this your first time in Paris?",
      "example_translation": "C'est ta première fois à Paris ?",
      "cloze": "Is this your ___ in Paris?",
      "tiles": ["Is", "this", "your", "first", "time", "in", "Paris"],
      "distractor_tiles": ["last time", "one time"],
      "notes": "Le brise-glace parfait avec un visiteur. Réponse : « Yes, first time! »",
      "tags": ["expression", "A2"]
    }
  ]
}
