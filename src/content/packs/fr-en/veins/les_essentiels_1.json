      "chunk": "How are you?",
      "word": "how",
      "translation": "comment",
      "example": "How are you today?",
      "example_translation": "Comment vas-tu aujourd'hui ?",
      "cloze": "___ are you today?",
      "tiles": ["How", "are", "you", "today"],
