      "tiles": ["I'm", "sorry", "I'm", "late"],
      "distractor_tiles": ["excuse", "sad"],
      "notes": "« I'm sorry » s'excuse ; « I'm sad » dit juste qu'on est triste.",
      "tags": ["expression", "A1"]
    },
    {
      "id": "ess_welcome",
      "chunk": "You're welcome",
      "word": "welcome",
      "translation": "de rien",
