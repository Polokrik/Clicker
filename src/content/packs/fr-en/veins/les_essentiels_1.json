      "tiles": ["Goodbye", "have", "a", "nice", "day"],
      "distractor_tiles": ["good", "happy"],
      "notes": "On répond souvent : « You too! » (Toi aussi.)",
      "tags": ["adjectif", "A1"]
    },
    {
      "id": "ess_please",
      "chunk": "please",
      "word": "please",
      "translation": "s'il vous plaît",
      "example": "Two coffees, please.",
