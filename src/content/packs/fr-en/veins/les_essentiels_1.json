      "distractor_tiles": ["soon", "tomorrow"],
      "notes": "« See you soon » = à bientôt ; « see you tomorrow » = à demain.",
      "tags": ["expression", "A1"]
    },
    {
      "id": "ess_nice_day",
      "chunk": "Have a nice day",
      "word": "nice",
      "translation": "agréable / bon",
