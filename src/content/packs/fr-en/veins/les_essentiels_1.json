      "cloze": "You're ___, it was nothing.",
      "tiles": ["You're", "welcome", "it", "was", "nothing"],
      "distractor_tiles": ["goodbye", "pleased"],
      "notes": "Réponse automatique à « thank you ». Aussi : « No problem. »",
      "tags": ["expression", "A1"]
    },
    {
      "id": "ess_meet",
      "chunk": "Nice to meet you",
      "word": "to meet",
      "translation": "rencontrer",
      "example": "Nice to meet you, I'm Paul.",
